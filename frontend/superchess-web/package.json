{
  "name": "superchess-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "sounds:fix": "node scripts/fix-sounds.cjs",
    "build:backend": "cd ../../backend/SuperChess.Api && dotnet build",
    "run:backend": "cd ../../backend/SuperChess.Api && dotnet run",
    "build:frontend": "npm run build",
    "run:frontend": "npm run dev",
    "build:all": "npm run build:backend && npm run build:frontend",
    "start:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run run:backend\" \"npm run run:frontend\""
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.0",
    "clsx": "^2.1.1",
    "howler": "^2.2.4",
    "next": "16.2.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/howler": "^2.2.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
